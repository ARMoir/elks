#!/bin/sh
# The panel returns a specific status only after Nano-X has shut down.
export NXCDE_SESSION=1
while :; do
    /bin/nxstart
    desktop_status=$?
    case "$desktop_status" in
        41)
            /bin/stty sane
            NXCDE_GAME=invaders /bin/invaders
            ;;
        42)
            /bin/stty sane
            NXCDE_GAME=pong /bin/ttypong
            ;;
        *) break ;;
    esac
    /bin/stty sane
done
