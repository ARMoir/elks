+static int
+ParseMS(int byte)
+{
+	/* Microsoft serial headers always set bit 6, unlike data bytes.
+	 * If a byte is lost on a slow machine, restart at the next header
+	 * instead of interpreting the next packet as a large movement.
+	 */
+	if (byte & SIXTH_BIT) {
+		buttons = (byte >> 4) & BOTTOM_TWO_BITS;
+		yd = ((byte & THIRD_FOURTH_BITS) << 4);
+		xd = ((byte & BOTTOM_TWO_BITS) << 6);
+		state = XADD;
+		return 0;
+	}
+	switch (state) {
+		case XADD:
+			xd |= (byte & BOTTOM_SIX_BITS);
+			state = YADD;
+			break;
+
+		case YADD:
+			yd |= (byte & BOTTOM_SIX_BITS);
+			state = IDLE;
+			if (xd > 127)
+				xd -= 256;
+			if (yd > 127)
+				yd -= 256;
+			return 1;
+	}
+	return 0;
+}
 
