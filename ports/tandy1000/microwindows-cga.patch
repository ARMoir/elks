+    PSD srcpsd, MWCOORD srcx, MWCOORD srcy, int op)
+{
+    MWCOORD x, y, firstx = 0, firsty = 0, stepx = 1, stepy = 1;
+    int oldmode;
+
+    if (w <= 0 || h <= 0) return;
+    if (dstpsd == srcpsd) {
+        if (dstx > srcx) { firstx = w - 1; stepx = -1; }
+        if (dsty > srcy) { firsty = h - 1; stepy = -1; }
+    }
+    oldmode = GdSetMode(op == MWROP_XOR ? MWROP_XOR : MWROP_COPY);
+    for (y = firsty; y >= 0 && y < h; y += stepy)
